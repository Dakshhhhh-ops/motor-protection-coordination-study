{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pip3 install --quiet -r requirements.txt && bash build.sh",
  "outputDirectory": "output",
  "installCommand": "echo 'dependencies are installed by buildCommand'",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/figures/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
